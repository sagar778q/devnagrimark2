<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="3dp" android:insetRight="3dp"
               android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/kb_key_pressed"/>
                <corners android:radius="10dp"/>
            </shape>
        </inset>
    </item>
    <item android:state_checked="true">
        <inset android:insetLeft="3dp" android:insetRight="3dp"
               android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/kb_key_active"/>
                <corners android:radius="10dp"/>
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="3dp" android:insetRight="3dp"
               android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/kb_key"/>
                <corners android:radius="10dp"/>
            </shape>
        </inset>
    </item>
</selector>
